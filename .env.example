# Environment variables for the ERP integration layer (reliability/js/erp/). Names only: copy this file to .env and fill it in on
# your own machine or in the hosting dashboard. .env is git-ignored. Never commit real values, hostnames or customer data.
#
# With none of these set the app uses the mock SAP adapter (demo data) and works as is.

# Which adapter: mock (default) | sap-s4hana | maximo
ERP_ADAPTER=mock
# Seconds a sync is kept before the API asks the ERP again (default 300)
ERP_CACHE_SECONDS=300

# SAP S/4HANA (adapter sap-s4hana; not live yet)
SAP_BASE_URL=
SAP_AUTH_TYPE=
SAP_CLIENT=
SAP_USER=
SAP_PASSWORD=
SAP_OAUTH_TOKEN_URL=
SAP_OAUTH_CLIENT_ID=
SAP_OAUTH_CLIENT_SECRET=

# IBM Maximo (adapter maximo; not live yet)
MAXIMO_BASE_URL=
MAXIMO_API_KEY=
