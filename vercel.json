{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/export-static.js",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/blogs", "destination": "/", "permanent": true },
    { "source": "/about", "destination": "/", "permanent": true },
    { "source": "/case-studies", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://powerlines-management.onrender.com/api/:path*" },
    { "source": "/health", "destination": "https://powerlines-management.onrender.com/health" },
    { "source": "/results/:path*", "destination": "https://powerlines-management.onrender.com/results/:path*" },
    { "source": "/socket.io/:path*", "destination": "https://powerlines-management.onrender.com/socket.io/:path*" },
    { "source": "/dashboard", "destination": "/inspection" },
    { "source": "/dashboard/:path*", "destination": "/inspection" },
    { "source": "/runs", "destination": "/inspection" },
    { "source": "/runs/:path*", "destination": "/inspection" },
    { "source": "/ai-detection", "destination": "/inspection" },
    { "source": "/ai-detection/:path*", "destination": "/inspection" },
    { "source": "/thermal-images", "destination": "/inspection" },
    { "source": "/thermal-images/:path*", "destination": "/inspection" },
    { "source": "/video-upload", "destination": "/inspection" },
    { "source": "/video-upload/:path*", "destination": "/inspection" },
    { "source": "/map", "destination": "/inspection" },
    { "source": "/map/:path*", "destination": "/inspection" },
    { "source": "/review-queue", "destination": "/inspection" },
    { "source": "/review-queue/:path*", "destination": "/inspection" },
    { "source": "/settings", "destination": "/inspection" },
    { "source": "/settings/:path*", "destination": "/inspection" },
    { "source": "/live-drone-feed", "destination": "/inspection" },
    { "source": "/live-drone-feed/:path*", "destination": "/inspection" },
    { "source": "/register", "destination": "/inspection" },
    { "source": "/register/:path*", "destination": "/inspection" },
    { "source": "/pending", "destination": "/inspection" },
    { "source": "/pending/:path*", "destination": "/inspection" },
    { "source": "/join", "destination": "/inspection" },
    { "source": "/join/:path*", "destination": "/inspection" },
    { "source": "/forgot-password", "destination": "/inspection" },
    { "source": "/forgot-password/:path*", "destination": "/inspection" },
    { "source": "/reset-password", "destination": "/inspection" },
    { "source": "/reset-password/:path*", "destination": "/inspection" },
    { "source": "/team", "destination": "/inspection" },
    { "source": "/team/:path*", "destination": "/inspection" },
    { "source": "/defect-analysis", "destination": "/inspection" },
    { "source": "/defect-analysis/:path*", "destination": "/inspection" },
    { "source": "/asset-health", "destination": "/inspection" },
    { "source": "/asset-health/:path*", "destination": "/inspection" },
    { "source": "/components", "destination": "/inspection" },
    { "source": "/components/:path*", "destination": "/inspection" },
    { "source": "/volt", "destination": "/inspection" },
    { "source": "/volt/:path*", "destination": "/inspection" },
    { "source": "/nova", "destination": "/inspection" },
    { "source": "/nova/:path*", "destination": "/inspection" },
    { "source": "/admin", "destination": "/inspection" },
    { "source": "/admin/:path*", "destination": "/inspection" }
  ]
}
